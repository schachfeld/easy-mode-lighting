{
  "name": "glow-lighting",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src packages server auth-client src-tauri/*.json src-tauri/capabilities/*.json tests scripts *.ts *.json *.yaml *.md .github",
    "format:check": "prettier --check src packages server auth-client src-tauri/*.json src-tauri/capabilities/*.json tests scripts *.ts *.json *.yaml *.md .github",
    "release:check": "node scripts/release.mjs check",
    "release:prepare": "node scripts/release.mjs prepare",
    "package:addon": "node scripts/package.mjs",
    "dev:mobile": "vite --mode mobile",
    "build:mobile": "tsc -b && vite build --mode mobile",
    "tauri": "tauri",
    "mobile:android": "tauri android dev",
    "mobile:ios": "tauri ios dev"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-stronghold": "^2.4.0",
    "@tauri-apps/plugin-websocket": "^2.5.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "yaml": "^2.9.1"
  }
}
