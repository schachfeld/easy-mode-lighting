{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local Glow UI: Home Assistant sockets and device storage. Remote pages receive no native permissions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "websocket:default",
    "store:default",
    "stronghold:default",
    "stronghold:allow-destroy",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        }
      ]
    }
  ]
}
